#langdef en-US "English"
#string STR_TITLE #language en-US ""
  "Ethernet MAC Addresses"
#string STR_HELP #language en-US ""
  "Set or regenerate Ethernet MAC addresses."
#string STR_RESTART #language en-US ""
  "Changes take effect after restart."
#string STR_PORT0 #language en-US ""
  "GMAC0"
#string STR_PORT1 #language en-US ""
  "GMAC1"
#string STR_CURRENT0 #language en-US ""
  "Current address"
#string STR_CURRENT1 #language en-US ""
  "Current address"
#string STR_PRIORITY #language en-US ""
  "Device tree > BIOS setting > factory eFuse > saved random address."
#string STR_OVERRIDE #language en-US ""
  "Use BIOS address"
#string STR_OVERRIDE_HELP #language en-US ""
  "Override the factory or automatic address. Device tree values win."
#string STR_ADDRESS #language en-US ""
  "MAC address"
#string STR_ADDRESS_HELP #language en-US ""
  "Enter six hex octets separated by colons. Use a nonzero unicast "
  "address."
#string STR_GENERATE #language en-US ""
  "Generate new random addresses"
#string STR_GENERATE_HELP #language en-US ""
  "Preview new local addresses. GMAC1 is adjacent to GMAC0. Save to "
  "apply."
#string STR_AUTO #language en-US ""
  "Restore automatic selection"
#string STR_AUTO_HELP #language en-US ""
  "Clear BIOS overrides. The original saved random address is kept."
#string STR_SAVE #language en-US ""
  "Save and restart"
#string STR_EMPTY #language en-US ""
  ""
#string STR_INVALID #language en-US ""
  "Invalid MAC. Enter six hex octets separated by colons; "
  "zero, multicast and broadcast addresses are not allowed."
#string STR_SAVE_FAILED #language en-US ""
  "MAC settings could not be saved. Changes have not been applied."

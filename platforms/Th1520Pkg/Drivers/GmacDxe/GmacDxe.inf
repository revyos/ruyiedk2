[Defines]
  INF_VERSION = 0x0001001b
  BASE_NAME = MelesGmacDxe
  FILE_GUID = bb310e21-cc34-4fce-bf71-cb1028c8f404
  MODULE_TYPE = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT = GmacInitialize
[Sources]
  Gmac.c
  Gmac.h
  Fdt.c
  Phy.c
  Address.c
[Packages]
  Th1520Pkg/Th1520Pkg.dec
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  CryptoPkg/CryptoPkg.dec
[LibraryClasses]
  Th1520BoardSupportLib
  FdtLib
  HobLib
  BaseLib
  BaseMemoryLib
  BaseCryptLib
  CacheMaintenanceLib
  DebugLib
  IoLib
  MemoryAllocationLib
  RngLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
[Protocols]
  gEfiSimpleNetworkProtocolGuid
  gEfiDevicePathProtocolGuid
  gFdtClientProtocolGuid
  gEfiCpuArchProtocolGuid
[Guids]
  gFdtHobGuid
  gEfiEventExitBootServicesGuid
[Depex]

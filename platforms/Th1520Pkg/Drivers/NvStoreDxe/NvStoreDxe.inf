  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PcdLib
  Th1520NvStoreLib
  Th1520SpiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiRuntimeServicesTableLib
  UefiRuntimeLib

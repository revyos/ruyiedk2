#langdef en-US "English"
#string STR_TITLE #language en-US ""
  "IPv4 Settings"
#string STR_HELP #language en-US ""
  "Configure the firmware IPv4 policy and static addresses."
#string STR_SUBMIT_HELP #language en-US ""
  "Press F10 to save. Esc allows you to discard unsaved changes."
#string STR_DHCP #language en-US ""
  "Use DHCP"
#string STR_DHCP_HELP #language en-US ""
  "Obtain addresses automatically. Saving does not wait for a lease."
#string STR_ADDRESS #language en-US ""
  "IPv4 address"
#string STR_ADDRESS_HELP #language en-US ""
  "Static IPv4 address, for example 192.168.1.10."
#string STR_MASK #language en-US ""
  "Subnet mask"
#string STR_MASK_HELP #language en-US ""
  "Subnet mask, for example 255.255.255.0."
#string STR_GATEWAY #language en-US ""
  "Gateway"
#string STR_GATEWAY_HELP #language en-US ""
  "Default gateway. Leave empty or enter 0.0.0.0 to remove it."
#string STR_DNS #language en-US ""
  "DNS servers"
#string STR_DNS_HELP #language en-US ""
  "Space-separated IPv4 addresses, up to 16. Leave empty to clear."
#string STR_SAVE #language en-US ""
  "Save Changes and Exit"
#string STR_SAVE_FAILED #language en-US ""
  "Could not apply IPv4 settings. Check the addresses and try again. "
  "Some fields may already have changed."
#string STR_TIMEOUT #language en-US ""
  "Address validation timed out. Reopen this page to check the result."
